# Telegram Bot
VKB_TELEGRAM_TOKEN=your_telegram_bot_token_here

# LLM Backend: "anthropic" | "ollama" | "claude-cli"
# anthropic  — Anthropic API (нужен ANTHROPIC_API_KEY, ~$3/млн токенов для Sonnet)
# ollama     — бесплатная локальная LLM через Ollama
# claude-cli — Claude Code CLI (входит в подписку Claude Max)
VKB_LLM_BACKEND=anthropic

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
VKB_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (бесплатная локальная альтернатива)
VKB_OLLAMA_URL=http://localhost:11434
VKB_OLLAMA_MODEL=llama3.1

# Whisper (распознавание речи, локально)
# Модели: tiny, base, small, medium, large-v3
# large-v3 — лучшее качество (~3GB VRAM)
# medium   — хороший баланс (~1.5GB)
# small    — быстрый вариант (~500MB)
VKB_WHISPER_MODEL=medium
VKB_WHISPER_DEVICE=auto

# TTS (озвучка ответов, бесплатно через Microsoft Edge)
# Русские голоса: ru-RU-DmitryNeural (муж), ru-RU-SvetlanaNeural (жен)
VKB_TTS_VOICE=ru-RU-DmitryNeural
VKB_TTS_RATE=+0%

# База знаний
VKB_KB_DIR=./kb_data
VKB_EMBEDDING_MODEL=intfloat/multilingual-e5-base
VKB_CHUNK_SIZE=1000
VKB_CHUNK_OVERLAP=200
VKB_TOP_K=5

# Диалог
VKB_MAX_HISTORY=20
